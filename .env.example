# Local runtime defaults. Copy to .env and edit as needed.
AGENTIC_ANSWER_RECOVERY_ENABLED=true
AGENTIC_ANSWER_RECOVERY_MODEL=qwen3:4b
AGENTIC_ANSWER_RECOVERY_NUM_PREDICT=640
ANSWER_ADAPTIVE_OUTPUT=true
ANSWER_MODE=detailed
CONTEXT_SAFETY_TOKENS=128
DATA_DIR=data
EMBEDDING_DEVICE=cpu
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_PROVIDER=sentence_transformers
FAST_ROUTING=true
LLM_PROVIDER=ollama
MAX_RAG_ATTEMPTS=2
MAX_SUBTASKS=6
NATIVE_TOOL_CALLING_ENABLED=true
NATIVE_TOOL_MODEL=qwen3:4b
NATIVE_TOOL_NUM_CTX=3072
NATIVE_TOOL_NUM_PREDICT=512
NATIVE_TOOL_READ_TIMEOUT_S=180
NATIVE_TOOL_STREAM=true
NATIVE_TOOL_TOTAL_TIMEOUT_S=300
OLLAMA_ANSWER_NUM_PREDICT=900
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=15m
OLLAMA_MODEL=qwen3:4b
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=180
OLLAMA_QUICK_NUM_CTX=3072
OLLAMA_QUICK_NUM_PREDICT=384
OLLAMA_READ_TIMEOUT_S=180
OLLAMA_SELECTION_NUM_PREDICT=512
OLLAMA_TEMPERATURE=0.1
OLLAMA_THINK=false
OLLAMA_TOP_K=
OLLAMA_TOP_P=
OLLAMA_TOTAL_TIMEOUT_S=480
QUICK_SINGLE_PASS=true
